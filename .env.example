# ---- Runtime-only configuration. Never commit real values. ----

# Core
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://127.0.0.1:4000

# Database
DATABASE_URL=postgres://wishubest:wishubest@localhost:5433/wishubest

# Auth
SESSION_TTL_HOURS=720
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Object storage (S3-compatible / MinIO). If unset, private local disk is used.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wishubest-private
S3_ACCESS_KEY_ID=wishubest
S3_SECRET_ACCESS_KEY=wishubest-dev-password
# Local fallback driver directory (used when S3_* is not set)
PRIVATE_STORAGE_DIR=./storage/private

# Payments (Stripe). Webhook secret verifies signatures; required for payments.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PAYMENT_CURRENCY_FALLBACK=USD

# Email (SMTP). If unset, mails are recorded in email_outbox but not sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="WishUBest <no-reply@wishubest.com>"

# Booking behaviour
BOOKING_EXPIRY_HOURS=48

# Internal revalidation hook (API -> Next on-demand cache purge)
REVALIDATE_TOKEN=dev-token-change-me

# E2E
TEST_DATABASE_URL=postgres://wishubest:wishubest@localhost:5433/wishubest_test
E2E_WEBHOOK_SECRET=whsec_test_secret
