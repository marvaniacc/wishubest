# ── WishUBest API + Web environment ─────────────────────────────────────────
# Copy to apps/api/.env (api) and apps/web/.env.local (web) as needed.
# Secrets are runtime-only: never required at build time.

# ── Core ──
NODE_ENV=development
API_PORT=8081
API_HOST=0.0.0.0
WEB_URL=http://localhost:3000
API_URL=http://127.0.0.1:8081

# ── Database (PostgreSQL) ──
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wishubest_mvp

# ── Sessions / auth ──
AUTH_COOKIE=wishubest_session
CSRF_COOKIE=wishubest_csrf
SESSION_TTL_SECONDS=604800

# ── KYC document storage ──
# local = private folder on disk (default on the dev server); s3 = S3-compatible (MinIO/AWS)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage/private
DOC_SIGNED_URL_TTL_SECONDS=300
# For S3/MinIO:
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=wishubest-private
# S3_ACCESS_KEY_ID=minioadmin
# S3_SECRET_ACCESS_KEY=minioadmin

# ── Payments (Stripe) ──
# stripe = real Stripe (test keys work in test mode); test = sandbox gateway (NON-production only)
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Email (SMTP) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="WishUBest <no-reply@wishubest.com>"

# ── Seed (first boot only) ──
ADMIN_EMAIL=admin@wishubest.local
ADMIN_PASSWORD=ChangeMe!2026
